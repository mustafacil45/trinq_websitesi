generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  store     Store?
}

model Store {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  address      String
  city         String        @default("İstanbul")
  phone        String?
  email        String?
  logo         String?
  category     String
  lat          Float?
  lng          Float?
  isActive     Boolean       @default(true)
  workingHours String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String        @unique
  owner        User          @relation(fields: [ownerId], references: [id])
  campaigns    Campaign[]
  stamps       StampCard[]
  transactions Transaction[]
}

model Campaign {
  id           String   @id @default(cuid())
  title        String
  description  String
  type         String
  discount     Float
  discountType String
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  usageLimit   Int?
  usageCount   Int      @default(0)
  createdAt    DateTime @default(now())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model StampCard {
  id             String   @id @default(cuid())
  customerName   String
  customerPhone  String?
  totalStamps    Int      @default(0)
  requiredStamps Int      @default(10)
  isCompleted    Boolean  @default(false)
  rewardTitle    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  amount    Float
  items     String
  createdAt DateTime @default(now())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model BusinessLead {
  id              String   @id @default(cuid())
  businessName    String
  businessAddress String
  fullName        String
  title           String
  phone           String
  email           String
  message         String
  createdAt       DateTime @default(now())
}
